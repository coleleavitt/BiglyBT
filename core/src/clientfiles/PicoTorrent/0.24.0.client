<?xml version="1.0" encoding="UTF-8"?>
<client>
	<protocol type="ltep">
		<!-- PicoTorrent uses libtorrent-rasterbar backend -->
		<clientName ltep="PicoTorrent/0.24.0" />
		<reservedBytes>0x00|0x00|0x00|0x00|0x00|0x10|0x00|0x05</reservedBytes>
	</protocol>
	<!-- PicoTorrent peer_id: -PI<MAJOR><MINOR 2 digits><PATCH>- -->
	<!-- Version 0.24.0 = -PI0240- -->
	<peerId type="anum" preFix="-PI0240-" length="20" isGlobal="false">
		<charSet>0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz</charSet>
	</peerId>
	<key type="hex" length="8" isGlobal="false" />
	<announce>
		<infoHash isLowerCase="true" exceptions="!()*-._~" />
		<query staticNumwant="200">
			<param>[info_hash]</param>
			<param>[peer_id]</param>
			<param>[port]</param>
			<param>[uploaded]</param>
			<param>[downloaded]</param>
			<param>[left]</param>
			<param>[corrupt]</param>
			<param>[key]</param>
			<param>{event}</param>
			<param>[numwant]</param>
			<param>[compact]</param>
			<param>[no_peer_id]</param>
			<param>&amp;supportcrypto=1</param>
			<param>&amp;redundant=0</param>
		</query>
		<header>
			<field>Host: {host}:{port}</field>
			<field>User-Agent: PicoTorrent/0.24.0</field>
			<field>Accept-Encoding: gzip</field>
			<field>Connection: close</field>
		</header>
	</announce>
</client>
